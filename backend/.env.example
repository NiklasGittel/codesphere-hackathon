# Copy to .env (never commit .env!)
GEMINI_API_KEY=
# Exact model id: check the model picker in AI Studio
GEMINI_MODEL=gemini-3.7-flash
# gemini | mock   (mock = scripted agent, no key needed)
AGENT_MODE=gemini
AGENT_FALLBACK_TO_MOCK=true
# Hard limits in seconds; after that the agent falls back to the scripted run
GEMINI_CALL_TIMEOUT_S=20
AGENT_TOTAL_TIMEOUT_S=60
# Live demo resource (payment-svc on Cloud Run). Empty = off.
# Auth: gcloud auth application-default login
LIVE_GCP_PROJECT=
LIVE_GCP_REGION=europe-west3
LIVE_RUN_SERVICE=payment-svc
# Synthetic traffic to payment-svc: N parallel requests every S seconds
LIVE_PROBE_PARALLEL=6
LIVE_PROBE_INTERVAL_S=2
# Simulated Redis/Black-Friday incident at start (false = only the live payment-svc fault)
START_IN_INCIDENT=true
# Shop checkout calls the real payment-svc when live mode is on
LIVE_CHECKOUT_USES_PAYMENT_SVC=true
